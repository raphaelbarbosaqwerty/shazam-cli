<div class="flex h-full">
  <!-- Sidebar -->
  <aside class="w-64 bg-zinc-900 border-r border-zinc-800 flex flex-col">
    <div class="p-4 border-b border-zinc-800">
      <h1 class="text-xl font-bold text-emerald-400">Shazam</h1>
      <p class="text-xs text-zinc-500 mt-1">Agent Orchestrator</p>
    </div>

    <nav class="flex-1 p-3 space-y-1">
      <.link
        navigate={~p"/"}
        class="flex items-center gap-3 px-3 py-2 rounded-lg text-sm text-zinc-300 hover:bg-zinc-800 hover:text-white transition-colors"
      >
        Feed
      </.link>
      <.link
        navigate={~p"/tasks"}
        class="flex items-center gap-3 px-3 py-2 rounded-lg text-sm text-zinc-300 hover:bg-zinc-800 hover:text-white transition-colors"
      >
        Tasks
      </.link>
      <.link
        navigate={~p"/agents"}
        class="flex items-center gap-3 px-3 py-2 rounded-lg text-sm text-zinc-300 hover:bg-zinc-800 hover:text-white transition-colors"
      >
        Agents
      </.link>
      <.link
        navigate={~p"/dashboard"}
        class="flex items-center gap-3 px-3 py-2 rounded-lg text-sm text-zinc-300 hover:bg-zinc-800 hover:text-white transition-colors"
      >
        Dashboard
      </.link>
      <.link
        navigate={~p"/config"}
        class="flex items-center gap-3 px-3 py-2 rounded-lg text-sm text-zinc-300 hover:bg-zinc-800 hover:text-white transition-colors"
      >
        Config
      </.link>
    </nav>

    <div class="p-4 border-t border-zinc-800">
      <div class="flex items-center gap-2">
        <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
        <span class="text-xs text-zinc-500">System Online</span>
      </div>
    </div>
  </aside>

  <!-- Main Content -->
  <main class="flex-1 flex flex-col min-h-0">
    <header class="px-6 py-4 border-b border-zinc-800 bg-zinc-900/50">
      <div class="flex items-center justify-between">
        <h2 class="text-lg font-semibold text-zinc-200">Shazam</h2>
        <div class="flex items-center gap-2 text-xs text-zinc-500">
          <span class="w-2 h-2 rounded-full bg-emerald-400"></span>
          Connected
        </div>
      </div>
    </header>

    <div class="flex-1 overflow-auto p-6">
      <p :if={Phoenix.Flash.get(@flash, :info)} class="p-3 rounded-lg bg-emerald-900/50 text-emerald-300 text-sm" role="alert">
        {Phoenix.Flash.get(@flash, :info)}
      </p>
      <p :if={Phoenix.Flash.get(@flash, :error)} class="p-3 rounded-lg bg-red-900/50 text-red-300 text-sm" role="alert">
        {Phoenix.Flash.get(@flash, :error)}
      </p>
      {@inner_content}
    </div>
  </main>
</div>
